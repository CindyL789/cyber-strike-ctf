{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered CTF player profile and scoring metrics",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "username": { "type": "string", "maxLength": 50, "minLength": 2 },
        "email": { "type": "string", "maxLength": 100 },
        "score": { "type": "number" },
        "solvesCount": { "type": "number" },
        "solvedChallengeIds": { "type": "array" },
        "unlockedHintIds": { "type": "array" },
        "tokens": { "type": "number", "description": "Cyber Credits token balance for purchasing hints, tools, and rewards" },
        "claimedTop5Reward": { "type": "boolean", "description": "Whether the player has claimed their seasonal Top 5 podium prize" },
        "badgeTitle": { "type": "string", "maxLength": 80, "description": "Special badge or podium title earned by the operator" },
        "categoryBreakdown": { "type": "object" },
        "role": { "type": "string", "enum": ["player", "admin"] },
        "lastSolveTime": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "username", "score", "solvesCount", "role", "createdAt"]
    },
    "Challenge": {
      "title": "Challenge",
      "description": "Capture The Flag problem and flags",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "enum": ["Web", "Crypto", "Reverse", "Forensics", "Pwn"] },
        "difficulty": { "type": "string", "enum": ["Easy", "Medium", "Hard", "Insane"] },
        "points": { "type": "number" },
        "author": { "type": "string", "maxLength": 50 },
        "solvesCount": { "type": "number" },
        "flag": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "tags": { "type": "array" },
        "hints": { "type": "array" },
        "writeup": { "type": "string", "maxLength": 3000 },
        "initialState": { "type": "object" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "category", "difficulty", "points", "flag", "description"]
    },
    "Activity": {
      "title": "Activity",
      "description": "Live CTF feed events for challenge captures",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "teamName": { "type": "string", "maxLength": 50 },
        "challengeTitle": { "type": "string", "maxLength": 100 },
        "category": { "type": "string" },
        "points": { "type": "number" },
        "timestamp": { "type": "string", "maxLength": 50 },
        "isFirstBlood": { "type": "boolean" },
        "isUser": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "teamName", "challengeTitle", "points"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Privileged administrator designation",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 100 },
        "assignedAt": { "type": "string" }
      },
      "required": ["email"]
    },
    "Team": {
      "title": "Team",
      "description": "CTF player teams, aggregated scores, combined solves, and invitation codes",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 60, "minLength": 2 },
        "tag": { "type": "string", "maxLength": 6, "minLength": 2 },
        "description": { "type": "string", "maxLength": 500 },
        "captainId": { "type": "string", "maxLength": 128 },
        "captainName": { "type": "string", "maxLength": 50 },
        "memberIds": { "type": "array" },
        "inviteCode": { "type": "string", "maxLength": 32 },
        "score": { "type": "number" },
        "solvesCount": { "type": "number" },
        "solvedChallengeIds": { "type": "array" },
        "isOpen": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "tag", "captainId", "memberIds", "inviteCode", "score", "solvesCount", "createdAt"]
    },
    "DailyConfig": {
      "title": "DailyConfig",
      "description": "Daily Challenge configuration, rotation tracking, and bonus point rules",
      "type": "object",
      "properties": {
        "date": { "type": "string", "maxLength": 20 },
        "challengeId": { "type": "string", "maxLength": 128 },
        "bonusPoints": { "type": "number" },
        "theme": { "type": "string", "maxLength": 100 },
        "updatedAt": { "type": "string" }
      },
      "required": ["date", "challengeId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection of registered player profiles, progression, and scoreboard data."
    },
    "/teams/{teamId}": {
      "schema": "Team",
      "description": "Teams aggregating member progress, shared challenge solves, and rankings."
    },
    "/challenges/{challengeId}": {
      "schema": "Challenge",
      "description": "Dynamic CTF challenges managed by administrators."
    },
    "/activity/{activityId}": {
      "schema": "Activity",
      "description": "Live challenge capture feed items broadcasted in real-time."
    },
    "/daily_config/{configId}": {
      "schema": "DailyConfig",
      "description": "Daily challenge rotation tracking and streak configuration."
    },
    "/admins/{userId}": {
      "schema": "Admin",
      "description": "List of authorized administrator user IDs."
    }
  }
}
