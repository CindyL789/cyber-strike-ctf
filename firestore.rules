rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrapAdminEmail() {
      return isSignedIn() && request.auth.token.email == "cindylouis2228@gmail.com";
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        isBootstrapAdminEmail()
      );
    }

    function isSelfJoin() {
      return isSignedIn()
        && !(request.auth.uid in resource.data.memberIds)
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'memberIds',
          'memberCount',
          'solvedChallengeIds',
          'score',
          'solvesCount',
          'categoryBreakdown',
          'updatedAt'
        ]);
    }

    function isMemberTeamUpdate() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return isSignedIn()
        && request.auth.uid in resource.data.memberIds
        && (
          changedKeys.hasOnly([
            'score',
            'solves',
            'solvesCount',
            'solvedChallengeIds',
            'categoryBreakdown',
            'lastSolveTime',
            'updatedAt'
          ])
          || (
            changedKeys.hasOnly([
              'memberIds',
              'memberCount',
              'score',
              'solves',
              'solvesCount',
              'solvedChallengeIds',
              'categoryBreakdown',
              'lastSolveTime',
              'updatedAt'
            ])
            && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
            && resource.data.memberIds.hasAll(request.resource.data.memberIds)
            && !(request.auth.uid in request.resource.data.memberIds)
          )
        );
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Player profiles and scores
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.role == (isBootstrapAdminEmail() ? 'admin' : 'player');
      allow update: if isSignedIn() && (
        (
          isOwner(userId)
          && request.resource.data.uid == userId
          && request.resource.data.role == resource.data.role
        )
        || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Teams aggregating scores, solved challenges, and invitation codes
    match /teams/{teamId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.captainId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.captainId == request.auth.uid ||
        isAdmin() ||
        isMemberTeamUpdate() ||
        isSelfJoin()
      );
      allow delete: if isSignedIn() && (resource.data.captainId == request.auth.uid || isAdmin());
    }

    // Challenges catalog
    match /challenges/{challengeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Public activity event stream
    match /activity/{activityId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Daily ops rotational schedule
    match /daily_ops/{opId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Transactions log
    match /transactions/{txId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
